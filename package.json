{
  "name": "@sudobility/characterbuilder_client",
  "version": "0.1.9",
  "description": "Network client and react-query hooks for CharacterBuilder",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "BUSL-1.1",
  "author": "Sudobility",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "dependencies": {
    "@sudobility/characterbuilder_types": "^0.1.7"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@tanstack/react-query": "~5.104.5",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "happy-dom": "~20.14.6",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "rimraf": "~6.1.3",
    "typescript": "~6.0.3",
    "vite": "~8.3.5",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/characterbuilder_client.git"
  }
}
